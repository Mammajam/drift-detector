# Copy to .env.local for local dev. In production, set these as encrypted env vars in Deployxa.
FIGMA_TOKEN=
DATABASE_URL=postgres://user:password@localhost:5432/drift_detector
# Comma-separated host suffixes the capture worker may load (SSRF guard). localhost is also allowed outside production.
PREVIEW_HOST_SUFFIXES=.deployxa.app
# Optional: max Postgres connections per app instance (default 5).
# DB_POOL_MAX=5
