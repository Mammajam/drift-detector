# Copy to .env.local for local dev. In production, set these as encrypted env vars in Deployxa.
FIGMA_TOKEN=
DATABASE_URL=postgres://user:password@localhost:5432/drift_detector
# Comma-separated host suffixes the capture worker may load (SSRF guard). localhost is also allowed outside production.
PREVIEW_HOST_SUFFIXES=.deployxa.app
# Optional: max Postgres connections per app instance (default 5).
# DB_POOL_MAX=5
# Sign-in. Without APP_PASSCODE, production is read-only (locally everything is open).
APP_PASSCODE=
# AUTH_SECRET=            # signs session cookies; defaults to APP_PASSCODE
# CAPTURE_API_TOKEN=      # bearer token for POST /api/captures from CI
# SEED_DEMO_ON_START=1    # load the demo project into an empty database on start
# DEPLOYXA_ROLLBACK_URL=  # target of the "Roll back on Deployxa" link

# Optional: cache exported Figma frames on disk (Figma rate-limits the images API hard on starter plans).
# FIGMA_FRAME_CACHE_DIR=.figma-cache
